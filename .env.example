OPENAI_API_KEY=
LANGSMITH_TRACING_V2=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ub-library-navigator

DATABASE_URL=sqlite:///analytics/sessions.db

CHROMA_PERSIST_DIR=vectorstore

ALMA_PRIMO_API_KEY=
ALMA_PRIMO_BASE_URL=

LIVE_CHAT_API_KEY=
LIVE_CHAT_BASE_URL=

# "password" is the only method implemented so far (see analytics/auth.py's
# registry). Set STAFF_DASHBOARD_PASSWORD too when using it. Leave both empty
# to keep the staff dashboard page disabled.
STAFF_DASHBOARD_AUTH_METHOD=
STAFF_DASHBOARD_PASSWORD=

# Gates the WHOLE chat app (not just the staff dashboard above) - leave both
# empty for local/dev use with no password; set both once the app is reachable
# over a public URL (e.g. deployed on Render), so a random visitor can't spend
# the real OPENAI_API_KEY below. Same "password" method/registry pattern.
APP_ACCESS_METHOD=
APP_ACCESS_PASSWORD=

# LLM provider: openai | anthropic | local (default openai)
LLM_PROVIDER=openai
LLM_MODEL=
# local only: OpenAI-compatible server, e.g. http://localhost:1234/v1 (LM Studio) or
# http://localhost:11434/v1 (Ollama). Leave empty to use Ollama's native API.
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
